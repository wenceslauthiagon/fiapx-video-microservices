{
  "name": "fiapx-video-processor",
  "version": "1.0.0",
  "description": "Sistema de processamento de vídeos com arquitetura hexagonal e microsserviços",
  "author": "FIAP Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node dist/main",
    "start:api": "node dist/main",
    "start:worker": "node dist/main.worker",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "node scripts/check-e2e-prereqs.js && jest --config jest.e2e.config.js",
    "smoke:test": "node scripts/smoke-test.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.2",
    "@nestjs/testing": "^10.2.8",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "supertest": "^7.1.3",
    "ts-jest": "^29.1.1",
    "@types/supertest": "^6.0.3",
    "ts-loader": "^9.5.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.8",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.2.8",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^10.2.8",
    "@nestjs/swagger": "^8.0.7",
    "@prisma/client": "^5.3.1",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dd-trace": "^5.19.0",
    "dotenv": "^16.3.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.15",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.3.1",
    "redis": "^4.6.11",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  }
}
