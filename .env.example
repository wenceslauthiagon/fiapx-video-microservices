# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fiapx_videos

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
VIDEO_JOB_ATTEMPTS=3

# JWT
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRATION=7d

# App
NODE_ENV=development
API_GATEWAY_PORT=3001

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TEMP_DIR=./temp

# SMTP (for notifications)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=user
SMTP_PASS=pass
SMTP_FROM=noreply@fiapx.local

# Password reset link target (backend page while frontend is not ready)
PASSWORD_RESET_URL_BASE=http://localhost:3001/auth/reset-password
